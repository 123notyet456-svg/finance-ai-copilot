# 本轮仅使用 Fake Adapter，不需要任何 API Key。
FINANCE_COPILOT_ENV=development
FINANCE_COPILOT_LOG_LEVEL=INFO
FINANCE_COPILOT_MAX_FILE_SIZE_MB=10
FINANCE_COPILOT_PROVIDER=fake
FINANCE_COPILOT_OPENAI_LLM_MODEL=gpt-5-mini
FINANCE_COPILOT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FINANCE_COPILOT_VECTOR_DB=data/policy_vectors.db
FINANCE_COPILOT_DATABASE=data/finance_copilot.db
FINANCE_COPILOT_RETRIEVAL_THRESHOLD=0.55
# OPENAI_API_KEY=  # 仅通过本地环境变量设置，禁止提交真实密钥。
