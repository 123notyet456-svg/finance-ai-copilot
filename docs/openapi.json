              "pass",
              "warning",
              "needs_review",
              "reject"
            ],
            "title": "Recommendation"
          },
          "review_status": {
            "type": "string",
            "title": "Review Status",
            "default": "pending"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "findings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Findings"
          },
          "recommendations": {
